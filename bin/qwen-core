#!/usr/bin/env node
// Ultra-simple wrapper: just runs the pre-compiled JS bundle.
// No tsx needed - no cross-platform binary issues - works on any OS.
import { resolve, dirname } from 'path';
import { fileURLToPath } from 'url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const distPath = resolve(__dirname, '..', 'dist', 'index.mjs');

// Just import the compiled bundle directly - no child process needed
import(distPath).catch((err) => {
  console.error(`[qwen-core] Failed to start: ${err.message}`);
  console.error(`[qwen-core] Make sure you've run 'npm run build' first.`);
  process.exit(1);
});
